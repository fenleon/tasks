<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Merged into the tool APK (single-module build). The
         tool's generated manifest provides the application class, label, and
         launcher; this library contributes the bootstrap provider (SDK server
         wiring). The LightSdkService the tool binds to comes from
         sdk:server's own manifest. -->
    <application>

        <!-- Wires the SDK server settings + cert check at app start, before
             the tool's first binder call (Application.onCreate runs before
             providers, so the bind in LightSdkApplication is unaffected).
             Also inits the shared repository. -->
        <provider
            android:name=".ServerBootstrapProvider"
            android:authorities="com.lightphone.tasks.server.bootstrap"
            android:exported="false" />
    </application>

</manifest>